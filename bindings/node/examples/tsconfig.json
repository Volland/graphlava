{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": false,
    "paths": {
      "@graphlava/node": ["../index.d.ts"],
      "@graphlava/node/sync": ["../sync.d.ts"]
